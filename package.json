{
  "name": "meteors-energy-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply meteors-crm-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply meteors-crm-db --remote",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/check-ui.mjs",
    "check": "npm run typecheck && npm run check:ui"
  },
  "dependencies": {
    "hono": "^4.6.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
